# Example environment configuration for requirements-to-test-cases.
#
# Nothing in this project currently makes external network or LLM API
# calls — the shipped enhancer (rtc.enhancer.RuleBasedEnhancer) runs
# entirely offline. This file demonstrates the recommended pattern for
# a FUTURE real LLM integration (see rtc/enhancer.py for where such an
# enhancer would plug in), so that pattern can be reviewed even though it
# is not wired up in this demo.
#
# Copy this file to ".env" (which is git-ignored) and fill in real values
# only if you implement and wire up a real LLM-backed enhancer.
# NEVER commit a real API key to source control.

# Placeholder only - not read by any code in this repository.
LLM_API_KEY=your-api-key-here

# Placeholder only - example of a model name a future enhancer might use.
LLM_MODEL=your-model-name-here

# Placeholder only - example of a base URL a future enhancer might call.
LLM_API_BASE_URL=https://api.example.com/v1
